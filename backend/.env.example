# ============================================================
# Copy this file to `.env` and fill in the real values.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (bash)
# ============================================================

# --- Application ---
APP_NAME="Arloraka Coffee - Sales Contribution API"
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Kredensial DB diisi nanti saat integrasi. Format driver: psycopg (async).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arloraka_cafe

# --- Auth / JWT ---
# Ganti SECRET_KEY di production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (frontend Next.js) ---
# Pisahkan dengan koma kalau lebih dari satu origin.
CORS_ORIGINS=http://localhost:3000
